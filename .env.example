# Copy to .env. Never commit .env.

# --- GitHub (filled in by scripts/bootstrap_github.sh) ---
# The board must be organization-owned: fine-grained tokens cannot reach
# Projects v2 owned by a user account. See docs/agent-auth.md.
GITHUB_OWNER_TYPE=organization
GITHUB_OWNER=
GITHUB_PROJECT_NUMBER=
GITHUB_PROJECT_ID=
# --- Crew identity (preferred): a GitHub App -------------------------------
# A PAT always acts as the human who created it, so the crew's issues, comments
# and commits would be attributed to the Sponsor — and GitHub forbids approving
# your own pull request. A GitHub App has its own crew[bot] identity.
# See docs/agent-auth.md. Installation id is discovered if left blank.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=.secrets/crew-app.pem
GITHUB_APP_INSTALLATION_ID=

# --- Reviewing identity (a second GitHub App) ------------------------------
# GitHub refuses an approval from the identity that opened the pull request, so
# one app can only ever comment on the crew's own work and every story stalls
# in Awaiting Approval. The reviewing app needs pull_requests: write and read
# on the org's projects. Unset, the crew falls back to the delivery app above
# and cannot approve its own pull requests.
GITHUB_REVIEW_APP_ID=
GITHUB_REVIEW_APP_PRIVATE_KEY=.secrets/crew-approver-app.pem
GITHUB_REVIEW_APP_INSTALLATION_ID=

# Fallback: fine-grained token for the agents. NOT your gh CLI credential.
# See docs/agent-auth.md for the exact permissions; verify with `crew auth`.
GITHUB_TOKEN=
CREW_REPO=crew
PILOT_REPO=sprint-metrics

# --- Inference ---
# SGLang on the DGX Spark. Discover with: crew doctor --host <spark-host>
SGLANG_BASE_URL=http://gx10-3703.local:8888/v1
# LiteLLM proxy in front of it.
CREW_LLM_BASE_URL=http://localhost:4000/v1
CREW_LLM_MODEL=crew-local
# The proxy's master key, and the crew's credential for it. ONE variable on
# purpose: docker-compose.yaml feeds this same value to LITELLM_MASTER_KEY, so
# the client and the server it talks to cannot drift apart. Without it every
# call answers 401. Generate one with:
#   python3 -c "import secrets; print('sk-' + secrets.token_hex(24))"
CREW_LLM_API_KEY=

# Admin UI login at http://localhost:4000/ui. Deliberately NOT the master key:
# one credential leaking should not hand over the other.
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=

# --- Escalation ---
# Escalation shells out to headless Claude Code using your subscription's OAuth
# credentials. There is NO ANTHROPIC_API_KEY here, by design: it would be metered
# separately from the subscription and could produce an unexpected bill.
CREW_ESCALATION_CMD=claude
