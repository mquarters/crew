# Copy to .env. Never commit .env.

# --- GitHub (filled in by scripts/bootstrap_github.sh) ---
GITHUB_OWNER=
GITHUB_PROJECT_NUMBER=
GITHUB_PROJECT_ID=
# Fine-grained token for the agents. NOT your gh CLI credential.
# See docs/agent-auth.md for the exact permissions; verify with `crew auth`.
GITHUB_TOKEN=
CREW_REPO=crew
PILOT_REPO=sprint-metrics

# --- Inference ---
# SGLang on the DGX Spark. Discover with: crew doctor --host <spark-host>
SGLANG_BASE_URL=http://gx10-3703.local:8888/v1
# LiteLLM proxy in front of it.
CREW_LLM_BASE_URL=http://localhost:4000/v1
CREW_LLM_MODEL=crew-local

# --- Escalation ---
# Escalation shells out to headless Claude Code using your subscription's OAuth
# credentials. There is NO ANTHROPIC_API_KEY here, by design: it would be metered
# separately from the subscription and could produce an unexpected bill.
CREW_ESCALATION_CMD=claude
